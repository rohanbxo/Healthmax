{
  "name": "@beta/core",
  "version": "0.1.0",
  "private": true,
  "description": "Pure TypeScript domain core shared by the API and the web app. No Express, Prisma, Redis, React or platform APIs (SPEC.md §0.6).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "rimraf": "^6.0.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.1"
  }
}
