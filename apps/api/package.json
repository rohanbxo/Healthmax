{
  "name": "@beta/api",
  "version": "0.1.0",
  "private": true,
  "description": "Express API and background worker. ROLE=api|worker|all (SPEC.md §10).",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b",
    "start": "node dist/server.js",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "pretest": "node scripts/prepare-test-db.mjs",
    "test:reset": "node scripts/prepare-test-db.mjs --reset",
    "test": "ts-mocha -p tsconfig.test.json \"test/**/*.test.ts\" --timeout 10000 --exit",
    "test:ci": "ts-mocha -p tsconfig.test.json \"test/**/*.test.ts\" --timeout 10000 --exit --reporter mocha-junit-reporter --reporter-options mochaFile=./test-results/junit.xml",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@beta/core": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.19.3",
    "bullmq": "^6.3.6",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "resend": "^6.28.1",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/web-push": "^3.6.4",
    "chai": "^4.5.0",
    "mocha": "^11.1.0",
    "mocha-junit-reporter": "^2.2.1",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.19.3",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.0",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  }
}
