# Copy to .env and fill in. Never commit .env (SPEC.md §12).
NODE_ENV=development
ROLE=all                      # api | worker | all
PORT=4000
APP_URL=http://localhost:5173

# Postgres (docker compose provides these defaults locally).
# The Prisma CLI does not read this file when run from apps/api, so copy
# DATABASE_URL and DATABASE_URL_TEST into a gitignored apps/api/.env as well.
# The application itself only ever reads process.env (SPEC.md §12).
DATABASE_URL=postgresql://beta:beta@localhost:5433/beta?schema=public
DATABASE_URL_TEST=postgresql://beta:beta@localhost:5433/beta_test?schema=public

# Redis
REDIS_URL=redis://localhost:6380

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-at-least-32-random-bytes-000000

# Web Push (SPEC.md §14, before M9) — npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email (SPEC.md §14, before M10)
# resend | ses | none. Left unset: resend when RESEND_API_KEY is set, else none.
# docker compose defaults it to ses, sending through Floci into Mailpit.
EMAIL_PROVIDER=
# resend needs RESEND_API_KEY and EMAIL_FROM; ses needs EMAIL_FROM — https://resend.com
RESEND_API_KEY=
EMAIL_FROM=Beta <onboarding@resend.dev>

# AWS — S3 cloud export and SES. docker compose points all of this at Floci
# (README "Local AWS with Floci"); for real AWS leave the endpoints and keys
# unset so the SDK uses its default credential chain.
AWS_REGION=us-east-1
# test / test for Floci, which accepts any credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# http://localhost:4566 for Floci outside compose. Unset means real AWS.
AWS_ENDPOINT_URL=
# The host the browser opens presigned links on, e.g. http://localhost:4566.
AWS_PUBLIC_ENDPOINT_URL=
# beta-exports locally. Unset disables cloud export.
S3_EXPORT_BUCKET=
EXPORT_URL_TTL_SECONDS=900

# Swagger UI is off in production unless this is true
DOCS_ENABLED=true
LOG_LEVEL=info
